{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nickwelsh/skyline",
    "description": "Queue monitoring for Laravel.",
    "license": "Apache-2.0",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/framework": "^12.0 || ^13.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "NickWelsh\\Skyline\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "format:check": "pint --test",
        "fixture:install": "composer install --working-dir=fixtures/laravel --no-interaction"
    },
    "extra": {
        "laravel": {
            "providers": [
                "NickWelsh\\Skyline\\SkylineServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
