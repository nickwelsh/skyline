{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@remix-run/react": ["./resources/js/skyline/remix-react.ts"],
      "remix-typedjson": ["./resources/js/skyline/remix-typedjson.ts"],
      "~/*": ["./resources/js/trigger/*"]
    },
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node", "vitest/globals"]
  },
  "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx", "resources/js/**/*.d.ts", "scripts/**/*.mjs", "tests/browser/**/*.ts", "tests/browser/**/*.tsx", "tests/fidelity/*.ts", "tests/fidelity/support/**/*.ts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "playwright.oracle.config.ts"]
}
