{
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node", "vitest/globals"]
  },
  "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx", "scripts/**/*.mjs", "tests/browser/**/*.ts", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
