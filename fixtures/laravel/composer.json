{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "skyline/laravel-fixture",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "nickwelsh/skyline": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "allow-plugins": {},
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
